{
  "schema": "agent-config/v1",
  "description": "agent 系列（cl/op/co/cm）通用配置：模型提供途径目录（deepseek-pay/opencode-go/commandcode-goat/opendesign-go）、模型发现/缓存、状态栏与各 agent 的机制参数。个性化选择（供应商/模型/强度）见 agent-custom.json，缺失时回退 agent-custom.json.refer；两文件深度合并后生效。",
  "model_discovery": {
    "enabled": true,
    "cache_ttl_seconds": 21600,
    "timeout_seconds": 5,
    "metadata_url": "https://models.dev/api.json"
  },
  "statusline": {
    "segments": [
      "model-with-reasoning",
      "current-dir",
      "hostname",
      "branch-changes",
      "run-state",
      "permissions",
      "approval-mode",
      "context-used",
      "context-window-size",
      "weekly-limit",
      "estimated-thread-cost",
      "thread-id",
      "fast-mode",
      "task-progress"
    ],
    "use_colors": true
  },
  "providers": {
    "deepseek-pay": {
      "label": "DeepSeek 官方（按量付费）",
      "env_key": "DEEPSEEK_PAY_API_KEY",
      "base_url": "https://api.deepseek.com",
      "anthropic_base_url": "https://api.deepseek.com/anthropic",
      "anthropic_auth": "auth_token",
      "wire_api": "responses",
      "supports_websockets": false,
      "opencode_provider_id": "deepseek",
      "models_url": "https://api.deepseek.com/models",
      "models_auth": "bearer",
      "models_metadata_provider": "deepseek",
      "supported_strengths": [ "high", "max" ],
      "commandcode": {
        "byok": true
      },
      "models": {
        "deepseek-v4-pro": {},
        "deepseek-v4.1-flash": { "context_window": 1000000 },
        "deepseek-v4-flash": { "context_window": 1000000 },
        "deepseek-v4-flash-vision-exp": { "context_window": 1000000 },
        "deepseek-flash": { "context_window": 1000000 }
      }
    },
    "opencode-go": {
      "label": "OpenCode Go 订阅（$10/月）",
      "env_key": "OPENCODE_GO_API_KEY",
      "base_url": "https://opencode.ai/zen/go/v1",
      "anthropic_base_url": "https://opencode.ai/zen/go",
      "anthropic_auth": "api_key",
      "wire_api": "responses",
      "supports_websockets": false,
      "opencode_provider_id": "opencode-go",
      "models_url": "https://opencode.ai/zen/go/v1/models",
      "models_auth": "none",
      "models_metadata_provider": "opencode-go",
      "supported_strengths": [ "none", "low", "medium", "high", "xhigh", "max", "ultra" ],
      "commandcode": {
        "byok": true
      },
      "codex": {
        "bridge_models": [ "deepseek-*" ],
        "bridge_protocol": "chat_completions",
        "bridge_auth": "bearer"
      },
      "models": {
        "grok-4.6": { "endpoint": "responses", "npm": "@ai-sdk/openai" },
        "gpt-5.6-luna": { "endpoint": "responses", "npm": "@ai-sdk/openai" },
        "muse-spark-1.3-contributor": { "endpoint": "responses", "npm": "@ai-sdk/openai" },
        "muse-spark-1.2-contributor": { "endpoint": "responses", "npm": "@ai-sdk/openai" },
        "glm-5.3-flash": { "endpoint": "chat/completions", "npm": "@ai-sdk/openai-compatible", "context_window": 1000000 },
        "glm-5.3": { "endpoint": "chat/completions", "npm": "@ai-sdk/openai-compatible" },
        "glm-5.2": { "endpoint": "chat/completions", "npm": "@ai-sdk/openai-compatible" },
        "glm-5.1": { "endpoint": "chat/completions", "npm": "@ai-sdk/openai-compatible" },
        "kimi-k3": { "endpoint": "chat/completions", "npm": "@ai-sdk/openai-compatible" },
        "kimi-k2.7-code": { "endpoint": "chat/completions", "npm": "@ai-sdk/openai-compatible" },
        "kimi-k2.6": { "endpoint": "chat/completions", "npm": "@ai-sdk/openai-compatible" },
        "longcat-2.0": { "endpoint": "chat/completions", "npm": "@ai-sdk/openai-compatible" },
        "deepseek-v4.1-flash": { "endpoint": "chat/completions", "npm": "@ai-sdk/openai-compatible", "context_window": 1000000 },
        "deepseek-v4-pro": { "endpoint": "chat/completions", "npm": "@ai-sdk/openai-compatible" },
        "deepseek-v4-flash": { "endpoint": "chat/completions", "npm": "@ai-sdk/openai-compatible", "context_window": 1000000 },
        "deepseek-v4-flash-vision-exp": { "endpoint": "chat/completions", "npm": "@ai-sdk/openai-compatible", "context_window": 1000000 },
        "mimo-v2.5": { "endpoint": "chat/completions", "npm": "@ai-sdk/openai-compatible" },
        "mimo-v2.5-pro": { "endpoint": "chat/completions", "npm": "@ai-sdk/openai-compatible" },
        "hy4-preview": { "endpoint": "chat/completions", "npm": "@ai-sdk/openai-compatible" },
        "hy3": { "endpoint": "chat/completions", "npm": "@ai-sdk/openai-compatible" },
        "minimax-m3": { "endpoint": "messages", "npm": "@ai-sdk/anthropic" },
        "minimax-m2.7": { "endpoint": "messages", "npm": "@ai-sdk/anthropic" },
        "minimax-m2.5": { "endpoint": "messages", "npm": "@ai-sdk/anthropic" },
        "qwen3.8-max": { "endpoint": "messages", "npm": "@ai-sdk/anthropic" },
        "qwen3.8-flash": { "endpoint": "messages", "npm": "@ai-sdk/anthropic", "context_window": 1000000 },
        "qwen3.7-max": { "endpoint": "messages", "npm": "@ai-sdk/anthropic" },
        "qwen3.7-plus": { "endpoint": "messages", "npm": "@ai-sdk/anthropic" },
        "qwen3.6-plus": { "endpoint": "messages", "npm": "@ai-sdk/anthropic" }
      }
    },
    "commandcode-goat": {
      "label": "Command Code GOAT 订阅（Provider API）",
      "env_key": "COMMANDCODE_GOAT_API_KEY",
      "base_url": "https://api.commandcode.ai/provider/v1",
      "anthropic_base_url": "https://api.commandcode.ai/provider",
      "anthropic_auth": "api_key",
      "wire_api": "responses",
      "supports_websockets": false,
      "opencode_provider_id": "commandcode",
      "models_url": "https://api.commandcode.ai/provider/v1/models",
      "models_auth": "none",
      "models_metadata_provider": "commandcode",
      "supported_strengths": [ "low", "medium", "high", "xhigh", "max" ],
      "codex": {
        "unsupported_models": [ "claude-*" ],
        "unsupported_reason": "Command Code Provider API 的 Claude 模型仅支持 /messages"
      },
      "models": {
        "deepseek/deepseek-v4.1-flash": {
          "context_window": 1000000,
          "supported_strengths": [ "low", "high", "max" ]
        },
        "deepseek/deepseek-v4-pro": {
          "context_window": 1000000,
          "supported_strengths": [ "low", "medium", "high", "max" ]
        },
        "gpt-6-sol": {
          "context_window": 1050000,
          "supported_strengths": [ "low", "medium", "high", "xhigh", "max" ]
        },
        "claude-sonnet-4-6": {
          "context_window": 1000000,
          "supported_strengths": [ "low", "medium", "high", "max" ]
        }
      }
    },
    "opendesign-go": {
      "label": "OpenDesign Go（OpenAI 兼容 + Anthropic 兼容根）",
      "env_key": "OPENDESIGN_GO_API_KEY",
      "base_url": "https://amr-link.open-design.ai/v1",
      "anthropic_base_url": "https://amr-link.open-design.ai",
      "anthropic_auth": "api_key",
      "wire_api": "responses",
      "supports_websockets": false,
      "opencode_provider_id": "opendesign-go",
      "models_url": "https://amr-link.open-design.ai/v1/models",
      "models_auth": "bearer",
      "supported_strengths": [ "low", "medium", "high", "xhigh", "max" ],
      "opencode": {
        "npm": "@ai-sdk/openai-compatible",
        "name": "OpenDesign Go"
      },
      "codex": {
        "bridge_models": [ "*" ],
        "bridge_protocol": "chat_completions",
        "bridge_auth": "bearer"
      },
      "commandcode": {
        "byok": true,
        "models_from_cache": true,
        "context_window": 1000000
      },
      "models": {}
    }
  },
  "agents": {
    "claude": {
      "permission_mode": "auto",
      "env": {
        "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "1000000",
        "DISABLE_AUTOUPDATER": "1"
      }
    },
    "opencode": {
      "agent": "build",
      "lsp": true,
      "autoupdate": false,
      "key_providers": [
        "deepseek-pay",
        "opencode-go",
        "commandcode-goat",
        "opendesign-go"
      ]
    },
    "codex": {
      "approval": "never",
      "sandbox": "danger-full-access",
      "model_catalog": {
        "enabled": true,
        "clone_template": "gpt-5.4-mini",
        "display_names": {
          "deepseek-flash": "DeepSeek Flash",
          "deepseek-v4.1-flash": "DeepSeek V4.1 Flash",
          "deepseek-v4-pro": "DeepSeek V4 Pro",
          "deepseek-v4-flash": "DeepSeek V4 Flash"
        }
      },
      "config": {
        "model_context_window": "1000000",
        "model_auto_compact_token_limit": "900000",
        "personality": "pragmatic",
        "approvals_reviewer": "auto_review",
        "forced_login_method": "api",
        "service_tier": "",
        "check_for_update_on_startup": "false",
        "features": {
          "fast_mode": "false"
        }
      }
    },
    "commandcode": {
      "permission_mode": "yolo",
      "trust": true,
      "skip_onboarding": true,
      "auto_update": false,
      "context_window": 1000000,
      "goal_turn_budget": 1000,
      "headless_max_turns": 1000,
      "headless_tools": "todo_write",
      "headless_tools_all": false,
      "statusline": {
        "version": 1,
        "enabled": true,
        "items": [
          { "id": "model-reasoning", "enabled": true },
          { "id": "context-used", "enabled": true },
          { "id": "cwd", "enabled": true },
          { "id": "git-branch", "enabled": true },
          { "id": "session-name", "enabled": true },
          { "id": "version", "enabled": true },
          { "id": "permission-mode", "enabled": true },
          { "id": "ide", "enabled": true },
          { "id": "pull-request", "enabled": true },
          { "id": "taste", "enabled": true },
          { "id": "background-tasks", "enabled": true },
          { "id": "hints", "enabled": true },
          { "id": "legacy-mods", "enabled": true },
          { "id": "phase-model", "enabled": true }
        ]
      }
    }
  }
}
