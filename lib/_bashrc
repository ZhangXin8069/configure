# ~/.bashrc: executed by bash(1) for non-login interactive shells.
# 由 bin/sh_init.sh 从 configure 仓库 lib/_bashrc 部署
# 优化要点: 去重复块(原两处 dircolors/ls/alert/bash_aliases), 窗口标题嵌入 PS1
#           (免 PROMPT_COMMAND 外调 echo), 别名统一由 env.sh 提供
# 启动链: ~/.bashrc → ~/configure/env.sh (或 ~/env.sh) → bin/ 进 PATH

# 非交互 shell 直接返回
case $- in
*i*) ;;
*) return ;;
esac

# ---- 历史记录 ----
HISTCONTROL=ignoreboth:erasedups
HISTFILESIZE=20000
HISTSIZE=10000
shopt -s histappend
shopt -s checkwinsize
shopt -s globstar

# ---- chroot 提示 ----
if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
    debian_chroot=$(cat /etc/debian_chroot)
fi

# ---- 窗口标题 (嵌入 PS1, 纯内置展开, 免每次提示符 fork echo) ----
case "$TERM" in
xterm*|rxvt*|Eterm*|aterm|kterm|gnome*|konsole*|interix)
    _title='\[\e]0;\u@\h: \w\a\]'
    ;;
screen*)
    _title='\[\e_\u@\h: \w\e\\\]'
    ;;
*)
    _title=
    ;;
esac

# ---- 彩色提示符 (tput 一次检测; 无色彩终端自动降级) ----
if [ -x /usr/bin/tput ] && tput setaf 1 >/dev/null 2>&1; then
    _c_green='\[\033[01;32m\]'
    _c_cyan='\[\033[01;34m\]'
    _c_reset='\[\033[00m\]'
else
    _c_green= _c_cyan= _c_reset=
fi
PS1="${_title}${debian_chroot:+($debian_chroot)}${_c_green}\u@\h${_c_reset}:${_c_cyan}\w${_c_reset}\$ "
unset _title _c_green _c_cyan _c_reset

# ---- dircolors (一次外部命令, 支持 ~/.dircolors 定制) ----
if command -v dircolors >/dev/null 2>&1; then
    if [ -r ~/.dircolors ]; then
        eval "$(dircolors -b ~/.dircolors)"
    else
        eval "$(dircolors -b)"
    fi
fi

# ---- 本地别名 (通用集由 env.sh 提供; 此处 ll/la/l 与 env.sh 值一致, 免顺序依赖) ----
alias ll='ls -lh'
alias la='ls -lAh'
alias l='ls -lah'
alias alert='notify-send --urgency=low -i "$([ $? = 0 ] && echo terminal || echo error)" "$(history|tail -n1|sed -e '\''s/^\s*[0-9]\+\s*//;s/[;&|]\s*alert$//'\'')"'

# ---- 用户私有别名 (可选) ----
if [ -f ~/.bash_aliases ]; then
    . ~/.bash_aliases
fi

# ---- 函数 ----
# ex: 一键解压, 用法: ex <file>
ex()
{
    if [ -f "$1" ]; then
        case "$1" in
        *.tar.bz2) tar xjf "$1" ;;
        *.tar.gz)  tar xzf "$1" ;;
        *.bz2)     bunzip2 "$1" ;;
        *.rar)     unrar x "$1" ;;
        *.gz)      gunzip "$1" ;;
        *.tar)     tar xf "$1" ;;
        *.tbz2)    tar xjf "$1" ;;
        *.tgz)     tar xzf "$1" ;;
        *.zip)     unzip "$1" ;;
        *.Z)       uncompress "$1" ;;
        *.7z)      7z x "$1" ;;
        *)         echo "'$1' cannot be extracted via ex()" ;;
        esac
    else
        echo "'$1' is not a valid file"
    fi
}
# colors: 打印终端色彩表
colors()
{
    local fgc bgc vals seq0
    printf "Color escapes are %s\n" '\e[${value};...;${value}m'
    printf "Values 30..37 are \e[33mforeground colors\e[m\n"
    printf "Values 40..47 are \e[43mbackground colors\e[m\n"
    printf "Value  1 gives a  \e[1mbold-faced look\e[m\n\n"
    for fgc in {30..37}; do
        for bgc in {40..47}; do
            fgc=${fgc#37}
            bgc=${bgc#40}
            vals="${fgc:+$fgc;}${bgc}"
            vals=${vals%%;}
            seq0="${vals:+\e[${vals}m}"
            printf "  %-9s" "${seq0:-(default)}"
            printf " ${seq0}TEXT\e[m"
            printf " \e[${vals:+${vals+$vals;}}1mBOLD\e[m"
        done
        echo
        echo
    done
}

# ---- 可编程补全 ----
if ! shopt -oq posix && [ -r /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
fi

# ---- 环境入口 (与 ~/.zshrc 一致; 存在才 source, 避免报错) ----
[ -r "${HOME}/configure/env.sh" ] && source "${HOME}/configure/env.sh"
[ -r "${HOME}/env.sh" ] && source "${HOME}/env.sh"
