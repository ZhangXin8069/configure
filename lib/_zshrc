# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi
# 由 bin/sh_init.sh 从 configure 仓库 lib/_zshrc 部署
# 优化要点: 删除与 env.sh 重复的 PATH 行; id -u → 内置 $UID; ${USER} → %n;
#           DISABLE_UNTRACKED_FILES_DIRTY 加速大仓库 git 状态; 精简模板注释

# Path to your oh-my-zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# 主题 (默认 robbyrussell; 装 powerlevel10k 后改为 powerlevel10k/powerlevel10k)
# git clone --depth=1 https://github.com/romkatv/powerlevel10k.git ${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/themes/powerlevel10k
ZSH_THEME="robbyrussell"
# 自动更新策略: disabled / auto / reminder
# zstyle ':omz:update' mode disabled

# 大仓库加速: 忽略未跟踪文件的 dirty 检查 (git_prompt_info 不再显示 untracked 标记)
DISABLE_UNTRACKED_FILES_DIRTY="true"

# 插件 (缺失时 oh-my-zsh 跳过并提示; 先 git clone 到 $ZSH_CUSTOM/plugins/)
# git clone https://github.com/zsh-users/zsh-syntax-highlighting.git ${ZSH_CUSTOM:-~/.oh-my-zsh/custom}/plugins/zsh-syntax-highlighting
# git clone https://github.com/zsh-users/zsh-autosuggestions ${ZSH_CUSTOM:-~/.oh-my-zsh/custom}/plugins/zsh-autosuggestions
# git clone https://github.com/MichaelAquilina/zsh-you-should-use.git $ZSH_CUSTOM/plugins/you-should-use
plugins=(
  git
  you-should-use
  zsh-syntax-highlighting
  zsh-autosuggestions
)

source $ZSH/oh-my-zsh.sh

# ---- 编辑器: 远程会话 vim, 本地优先 mvim(有则用), 其余 vim ----
if [[ -n $SSH_CONNECTION ]]; then
  export EDITOR='vim'
elif command -v mvim >/dev/null 2>&1; then
  export EDITOR='mvim'
else
  export EDITOR='vim'
fi

# ---- 别名 ----
alias zshconfig='${EDITOR:-vim} ~/.zshrc'
alias ohmyzsh='${EDITOR:-vim} ~/.oh-my-zsh'

# ---- 提示符 (全部 zsh 内置展开, 无外部命令) ----
current_time="%{$fg_bold[white]%}%D{%Y/%m/%d %A %H:%M:%S}%{$reset_color%}"
if (( UID == 0 )); then
    user_display="%{$fg_bold[red]%}root%{$reset_color%}@%{$fg_bold[green]%}%m"
else
    user_display="%{$fg_bold[cyan]%}%n%{$reset_color%}@%{$fg_bold[green]%}%m"
fi
arrow_status="%(?:%{$fg_bold[green]%}➜:%{$fg_bold[red]%}➜)"
NEWLINE=$'\n'
PROMPT='${user_display}${NEWLINE}${current_time}${NEWLINE}${arrow_status} %{$fg[magenta]%}%d%{$reset_color%} $(git_prompt_info)'
# Fix: disable complete_in_word to prevent Tab completion from appending
# instead of replacing the typed word (e.g., "py" + Tab → "pypython")
unsetopt complete_in_word

# @CLEAR
clear

# @ENV@
# 环境入口 (与 ~/.bashrc 一致; 存在才 source, 避免报错; env.sh 内部已做 PATH 防重复)
[ -r "${HOME}/configure/env.sh" ] && source "${HOME}/configure/env.sh"
[ -r "${HOME}/env.sh" ] && source "${HOME}/env.sh"
# @CLEAR
# clear
